{
  "name": "foodbook",
  "version": "0.1.0",
  "private": true,
  "description": "Foodbook & Catering Operations — operationele keten van Foodbook tot factuur",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @foodbook/web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p scripts",
    "lint": "npm run lint --workspaces --if-present",
    "voorbeeld": "tsx scripts/genereer-voorbeelddocumenten.mts",
    "voorbeeld:beeld": "tsx scripts/screenshot-voorbeelddocumenten.mts",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "sharp@0.35.4": true,
    "sharp@0.34.5": true
  }
}
