# Kopieer dit bestand naar infra/.env en vul de waarden in.
# infra/.env staat in .gitignore en hoort nooit in versiebeheer.

# Database
POSTGRES_USER=foodbook
POSTGRES_PASSWORD=verander-dit-in-een-lang-willekeurig-wachtwoord
POSTGRES_DB=foodbook

# Payload-sleutel. Genereer met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=verander-dit-in-een-lang-willekeurig-geheim

# Het adres waarop de applicatie bereikbaar is, met https:// en zonder afsluitende slash.
# Zonder geldig domein dat naar dit server-IP wijst, werkt automatisch HTTPS niet.
SITE_URL=https://foodbook.example.nl

# E-mailadres voor de meldingen van Let's Encrypt over het certificaat.
ACME_EMAIL=beheer@example.nl

# Alleen bij de ALLEREERSTE uitrol op een lege database op true zetten, zodat de tabellen
# worden aangemaakt. Daarna weer op false (of deze regel weghalen): vanaf dat moment gaat het
# databaseschema uitsluitend via migraties, zodat een uitrol nooit gegevens kan wegvagen.
DB_PUSH=false
