{
  "name": "@foodbook/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js-app met embedded Payload CMS (Beheer) en de Foodbook-presentatielaag",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "generate:types": "cross-env NODE_ENV=development payload generate:types",
    "generate:importmap": "cross-env NODE_ENV=development payload generate:importmap",
    "seed": "cross-env NODE_ENV=development payload run src/seed/index.ts",
    "seed:demo": "cross-env NODE_ENV=development payload run src/seed/demo.ts",
    "acceptatietest": "cross-env NODE_ENV=development payload run src/acceptatietest.ts",
    "migrate:create": "cross-env NODE_ENV=development payload migrate:create",
    "migrate": "payload migrate",
    "migrate:status": "payload migrate:status"
  },
  "dependencies": {
    "@foodbook/calculation-engine": "*",
    "@foodbook/documents": "*",
    "@foodbook/i18n": "*",
    "@foodbook/shared-types": "*",
    "@payloadcms/db-postgres": "^3.0.0",
    "@payloadcms/db-sqlite": "^3.90.1",
    "@payloadcms/next": "^3.0.0",
    "@payloadcms/richtext-lexical": "^3.0.0",
    "next": "^16.3.3",
    "payload": "^3.0.0",
    "puppeteer-core": "^25.11.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5"
  }
}
