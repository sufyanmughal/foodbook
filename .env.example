# Database
# Productie/dev met docker-compose (infra/docker-compose.yml):
DATABASE_URI=postgres://foodbook:foodbook@localhost:5432/foodbook

# Payload
PAYLOAD_SECRET=verander-dit-in-productie

# Publieke URL van de applicatie
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Media-opslag
# dev  -> lokale schijf
# prod -> S3-compatible (MinIO lokaal via infra/docker-compose.yml)
MEDIA_STORAGE=lokaal
S3_BUCKET=foodbook-media
S3_REGION=eu-central-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=foodbook
S3_SECRET_ACCESS_KEY=foodbook123

# E-mail (transacties: offertes, facturen, lijsten)
EMAIL_FROM=administratie@example.nl
RESEND_API_KEY=
